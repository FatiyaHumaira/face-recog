# Face Recognition API Environment Configuration
# Copy file ini menjadi .env dan customize sesuai kebutuhan

# ============================================================================
# Face Recognition Settings
# ============================================================================

# Path untuk menyimpan embeddings database
FACE_DB_PATH=face_db

# Threshold untuk recognition (0.0 - 1.0)
# Semakin rendah = lebih mudah di-recognize (lebih banyak false positive)
# Semakin tinggi = lebih ketat (mungkin lebih banyak false negative)
RECOGNITION_THRESHOLD=0.45

# Blur threshold untuk validasi quality foto
# Semakin tinggi = lebih strict terhadap blurred images
BLUR_THRESHOLD=100.0

# Maximum yaw angle untuk side face detection (dalam derajat)
# Foto yang terlalu miring akan ditolak
MAX_YAW=30

# ============================================================================
# API Server Settings
# ============================================================================

# Host untuk API server
API_HOST=0.0.0.0

# Port untuk API server
API_PORT=8000

# Enable auto-reload saat ada perubahan code
# Set ke False untuk production
API_RELOAD=True

# ============================================================================
# Model Settings
# ============================================================================

# InsightFace model name
# Options: buffalo_l, buffalo_m, etc.
MODEL_NAME=buffalo_l

# Provider untuk model execution
# Options: CPUExecutionProvider, CUDAExecutionProvider (untuk GPU)
PROVIDERS=CPUExecutionProvider

# ============================================================================
# Logging Settings
# ============================================================================

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Security & CORS Settings
# ============================================================================

# CORS origins (comma-separated)
# * = allow all (hanya untuk development!)
CORS_ORIGINS=*

# ============================================================================
# Environment
# ============================================================================

# Environment mode
# Options: development, production
ENVIRONMENT=development

# ============================================================================
# Image Processing Settings
# ============================================================================

# Maximum image size dalam bytes (50MB default)
MAX_IMAGE_SIZE=52428800

# Supported image formats (comma-separated)
SUPPORTED_FORMATS=jpg,jpeg,png,bmp

# ============================================================================
# Timeout Settings
# ============================================================================

# Timeout untuk download image dari URL (dalam detik)
IMAGE_DOWNLOAD_TIMEOUT=30

# Timeout untuk registration (dalam detik)
REGISTRATION_TIMEOUT=60

# ============================================================================
# Database Settings (untuk future use)
# ============================================================================

# Database connection string jika menggunakan database
# DATABASE_URL=sqlite:///./face_recognition.db
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ============================================================================
# Notifikasi Settings (untuk future use)
# ============================================================================

# Webhook URL untuk notifikasi recognition results
# WEBHOOK_URL=https://example.com/webhook/recognition

# ============================================================================
# Monitoring & Analytics (untuk future use)
# ============================================================================

# Enable metrics/analytics
ENABLE_METRICS=False

# Metrics export interval (dalam menit)
METRICS_INTERVAL=5
